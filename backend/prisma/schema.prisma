// ==============================================================================
// 12. ADAPTIVE COMPETENCY-BASED REVISION ENGINE
// ==============================================================================

model CompetencyGroup {
  id            String   @id @default(uuid())
  courseId      String
  parentGroupId String?
  name          String
  description   String?
  importance    Float    @default(1.0)
  orderIndex    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course                Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentGroup           CompetencyGroup?      @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups           CompetencyGroup[]     @relation("GroupHierarchy")
  topics                LearningTopic[]
  userGroupCompetencies UserGroupCompetency[]
  revisionSessions      RevisionSession[]

  @@index([courseId, orderIndex])
  @@index([parentGroupId])
  @@map("competency_groups")
}

model LearningTopic {
  id               String   @id @default(uuid())
  courseId         String
  groupId          String
  parentTopicId    String?
  name             String
  code             String   @unique
  description      String?
  importance       Float    @default(1.0)
  difficulty       Float    @default(0.5)
  estimatedMinutes Int      @default(10)
  orderIndex       Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course                Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group                 CompetencyGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentTopic           LearningTopic?            @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: SetNull)
  childTopics           LearningTopic[]           @relation("TopicHierarchy")
  prerequisites         TopicPrerequisite[]       @relation("TopicPrerequisites")
  prerequisiteFor       TopicPrerequisite[]       @relation("PrerequisiteForTopics")
  competencyMappings    LearningTopicCompetency[]
  questionMappings      AssessmentQuestionTopic[]
  lessonMappings        LessonTopic[]
  learningEvents        LearningEvent[]
  userTopicCompetencies UserTopicCompetency[]
  userTopicErrors       UserTopicError[]
  sessionItems          RevisionSessionItem[]
  revisionOutcomes      RevisionOutcome[]

  @@index([courseId])
  @@index([groupId])
  @@index([parentTopicId])
  @@index([code])
  @@map("learning_topics")
}

model TopicPrerequisite {
  id                  String   @id @default(uuid())
  prerequisiteTopicId String
  dependentTopicId    String
  edgeWeight          Float    @default(1.0)
  dependencyType      String   @default("DIRECT")
  createdAt           DateTime @default(now())

  prerequisiteTopic LearningTopic @relation("PrerequisiteForTopics", fields: [prerequisiteTopicId], references: [id], onDelete: Cascade)
  dependentTopic    LearningTopic @relation("TopicPrerequisites", fields: [dependentTopicId], references: [id], onDelete: Cascade)

  @@unique([prerequisiteTopicId, dependentTopicId])
  @@index([prerequisiteTopicId])
  @@index([dependentTopicId])
  @@map("topic_prerequisites")
}

model LearningTopicCompetency {
  id           String   @id @default(uuid())
  topicId      String
  competencyId String
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())

  topic      LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  competency Competency    @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([topicId, competencyId])
  @@index([topicId])
  @@index([competencyId])
  @@map("learning_topic_competencies")
}

model AssessmentQuestionTopic {
  id         String   @id @default(uuid())
  questionId String
  topicId    String
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now())

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    LearningTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([questionId, topicId])
  @@index([questionId])
  @@index([topicId])
  @@map("assessment_question_topics")
}

model LessonTopic {
  id        String   @id @default(uuid())
  lessonId  String
  topicId   String
  createdAt DateTime @default(now())

  lesson Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic  LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([lessonId, topicId])
  @@index([lessonId])
  @@index([topicId])
  @@map("lesson_topics")
}

model LearningEvent {
  id                    String            @id @default(uuid())
  userId                String
  courseId              String?
  groupId               String?
  topicId               String
  eventType             LearningEventType
  source                String
  assessmentAttemptId   String?
  questionId            String?
  revisionSessionId     String?
  lessonId              String?
  correct               Boolean?
  responseTimeMs        Int?
  hintsUsed             Int?              @default(0)
  confidenceRating      Float?
  difficulty            Float?
  rawScore              Float?
  normalizedPerformance Float?
  previousCompetency    Float?
  newCompetency         Float?
  metadata              Json?
  occurredAt            DateTime          @default(now())
  createdAt             DateTime          @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId])
  @@index([topicId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("learning_events")
}

model UserTopicCompetency {
  id                     String    @id @default(uuid())
  userId                 String
  topicId                String
  competencyScore        Float     @default(50.0)
  confidenceScore        Float     @default(0.1)
  accuracyScore          Float     @default(50.0)
  speedScore             Float     @default(50.0)
  hintScore              Float     @default(100.0)
  confidenceRatingScore  Float     @default(50.0)
  independenceScore      Float     @default(100.0)
  attemptCount           Int       @default(0)
  meaningfulAttemptCount Int       @default(0)
