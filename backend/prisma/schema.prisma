// ==============================================================================
// CAPACITY CONNECT — ENTERPRISE DATABASE SCHEMA (SOURCE OF TRUTH)
// Digital Capacity Building and Learning Management Portal
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 1. ENUMS
// ==============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  TRAINER
  TRAINEE
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SkillSource {
  PROFILE
  ASSESSMENT
  COURSE_COMPLETION
  CERTIFICATE
  TRAINER_EVALUATION
  AI_ANALYSIS
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum LessonContentType {
  VIDEO
  PDF
  ARTICLE
  QUIZ
  LINK
  DOCUMENT
  PPT
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum ResourceType {
  VIDEO
  PDF
  PRESENTATION
  DOCUMENT
  LINK
  IMAGE
}

enum ResourceStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AssessmentType {
  MCQ
  QUESTIONNAIRE
  PRACTICAL
  SURVEY
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum CompetencySource {
  PROFILE
  ASSESSMENT
  COURSE_COMPLETION
  CERTIFICATE
  TRAINER_EVALUATION
  AI_ANALYSIS
}

enum GapPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GapStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum RequirementCriticality {
  CORE
  IMPORTANT
  NORMAL
  OPTIONAL
}

enum RecommendationType {
  COURSE
  TRAINER
  RESOURCE
  LEARNING_PATH
}

enum RecommendationSource {
  RULE_ENGINE
  AI
  ADMIN
}

enum RecommendationStatus {
  ACTIVE
  VIEWED
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum RecommendationEventType {
  IMPRESSION
  VIEW
  CLICK
  SAVE
  DISMISS
  START
  ENROLL
  COMPLETE
  ABANDON
  SHARE
}

enum RecommendationFeedbackType {
  NOT_RELEVANT
  ALREADY_KNOW_THIS
  TOO_DIFFICULT
  TOO_EASY
  NOT_NOW
  WRONG_TOPIC
  INTERESTING
}

enum MatchSource {
  RULE_ENGINE
  AI
  ADMIN
}

enum FeedbackStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum AnnouncementType {
  GENERAL
  COURSE
  ACHIEVEMENT
  LEARNING_CONTENT
  SYSTEM
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  SYSTEM
  COURSE
  ASSESSMENT
  ENROLLMENT
  ACHIEVEMENT
  RECOMMENDATION
  FEEDBACK
  ANNOUNCEMENT
}

enum AchievementType {
  COURSE_COMPLETION
  ASSESSMENT_EXCELLENCE
  SKILL_MASTERY
  STREAK
  BADGE
}

enum LearningEventType {
  LESSON_VIEWED
  LESSON_COMPLETED
  QUIZ_ANSWERED
  PRACTICE_ATTEMPT
  ASSESSMENT_ANSWERED
  ASSESSMENT_COMPLETED
  REVISION_STARTED
  REVISION_COMPLETED
  RETRIEVAL_ATTEMPT
  DIAGNOSTIC_ATTEMPT
}

enum RevisionSessionStatus {
  GENERATED
  STARTED
  COMPLETED
  ABANDONED
  EXPIRED
}

enum RevisionMode {
  RECOVERY
  REBUILD
  STRENGTHEN
  RETRIEVE
  MAINTAIN_CHALLENGE
}

// ==============================================================================
// 2. IDENTITY & ORGANIZATION
// ==============================================================================

model Organization {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?
  logoUrl     String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relationships
  departments   Department[]
  users         User[]
  courses       Course[]
  resources     Resource[]
  announcements Announcement[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

// ==============================================================================
// 3. USER & AUTHENTICATION SESSIONS
// ==============================================================================

model User {
  id             String     @id @default(uuid())
  organizationId String
  departmentId   String?
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String?
  phone          String?
  avatarUrl      String?
  role           Role       @default(TRAINEE)
  status         UserStatus @default(PENDING)
  emailVerified  Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Organization & Profile Relationships
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  traineeProfile TraineeProfile?
  trainerProfile TrainerProfile?

  // Auth & Audit
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  // Skills & Professional Experience
  userSkills      UserSkill[]
  qualifications  Qualification[]
  workExperiences WorkExperience[]
  certificates    Certificate[]

  // Learning & Instruction
  taughtCourses      Course[]            @relation("TrainerCourses")
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  uploadedResources  Resource[]          @relation("ResourceUploader")
  createdAssessments Assessment[]        @relation("TrainerAssessments")
  assessmentAttempts AssessmentAttempt[]

  // Competencies & Development
  userCompetencies UserCompetency[]
  skillGaps        SkillGap[]
  recommendations  Recommendation[] @relation("UserRecommendations")
  trainerRecsGiven Recommendation[] @relation("TrainerRecommendations")
  traineeMatches   TrainerMatch[]   @relation("TraineeMatches")
  trainerMatches   TrainerMatch[]   @relation("TrainerMatches")

  // Intelligent Recommendation Engine
  recommendationBatches   RecommendationBatch[]
  recommendationEvents    RecommendationEvent[]
  recommendationFeedbacks RecommendationFeedback[]
  recommendationProfile   UserRecommendationProfile?

  // Social & Engagement
  feedbackGiven        Feedback[]     @relation("FeedbackAuthor")
  feedbackReceived     Feedback[]     @relation("TrainerFeedback")
  createdAnnouncements Announcement[] @relation("AnnouncementAuthor")
  notifications        Notification[]
  achievements         Achievement[]

  // Adaptive Revision Engine
  learningEvents        LearningEvent[]
  userTopicCompetencies UserTopicCompetency[]
  userGroupCompetencies UserGroupCompetency[]
  userTopicErrors       UserTopicError[]
  revisionSessions      RevisionSession[]
  revisionOutcomes      RevisionOutcome[]

  // AI Skill Gap Analyzer
  skillGapAnalyses      SkillGapAnalysis[]

  @@index([email])
  @@index([organizationId])
  @@index([departmentId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RolePermissionMapping {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       AppRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AppPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AppRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermissionMapping[]

  @@map("roles")
}

model AppPermission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermissionMapping[]

  @@map("permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==============================================================================
// 4. USER PROFILES
// ==============================================================================

model TraineeProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  designation       String?
  bio               String?
  interests         String[] @default([])
  profileCompletion Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trainee_profiles")
}

model TrainerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  designation      String
  organizationName String?
  bio              String
  yearsExperience  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise TrainerExpertise[]

  @@map("trainer_profiles")
}

// ==============================================================================
// 5. SKILLS, QUALIFICATIONS & CERTIFICATES
// ==============================================================================

model Skill {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills       UserSkill[]
  trainerExpertise TrainerExpertise[]

  @@index([category])
  @@index([code])
  @@map("skills")
}

model UserSkill {
  id               String      @id @default(uuid())
  userId           String
  skillId          String
  proficiencyLevel Int         @default(1)
  yearsExperience  Int?
  source           SkillSource @default(PROFILE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model TrainerExpertise {
  id               String   @id @default(uuid())
  trainerId        String
  skillId          String
  proficiencyLevel Int      @default(1)
  yearsExperience  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([trainerId, skillId])
  @@index([trainerId])
  @@index([skillId])
  @@map("trainer_expertise")
}

model Qualification {
  id           String    @id @default(uuid())
  userId       String
  degree       String
  fieldOfStudy String
  institution  String
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("qualifications")
}

model WorkExperience {
  id          String    @id @default(uuid())
  userId      String
  companyName String
  jobTitle    String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("work_experiences")
}

model Certificate {
  id                  String            @id @default(uuid())
  userId              String
  title               String
  issuingOrganization String
  credentialId        String?
  issueDate           DateTime
  expiryDate          DateTime?
  certificateUrl      String?
  verificationStatus  CertificateStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications CertificateVerification[]

  @@index([userId])
  @@index([verificationStatus])
  @@map("certificates")
}

model CertificateVerification {
  id                 String    @id @default(uuid())
  certificateId      String
  verificationMethod String
  provider           String?
  verificationUrl    String?
  verifiedAt         DateTime?
  verifiedBy         String?
  metadata           Json?
  createdAt          DateTime  @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@map("certificate_verifications")
}

// ==============================================================================
// 6. COURSES & LEARNING
// ==============================================================================

model Course {
  id              String           @id @default(uuid())
  organizationId  String
  trainerId       String
  title           String
  slug            String           @unique
  description     String
  thumbnailUrl    String?
  category        String
  difficulty      CourseDifficulty @default(BEGINNER)
  durationMinutes Int              @default(0)
  status          CourseStatus     @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  // Relations
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trainer            User               @relation("TrainerCourses", fields: [trainerId], references: [id], onDelete: Restrict)
  modules            CourseModule[]
  enrollments        Enrollment[]
  courseResources    CourseResource[]
  assessments        Assessment[]
  courseCompetencies CourseCompetency[]
  recommendations    Recommendation[]
  feedbacks          Feedback[]

  // Adaptive Revision Engine
  competencyGroups CompetencyGroup[]
  learningTopics   LearningTopic[]
  revisionSessions RevisionSession[]

  // Self-referencing Many-to-Many Prerequisites
  prerequisites   CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisiteFor CoursePrerequisite[] @relation("PrerequisiteForCourses")

  // AI Skill Gap Analyzer
  courseSkillGaps  SkillGap[]         @relation("CourseSkillGaps")
  skillGapAnalyses SkillGapAnalysis[]

  // Intelligent Recommendation Engine
  recommendationProfile CourseRecommendationProfile?
  recommendationEvents  RecommendationEvent[]

  @@index([organizationId])
  @@index([trainerId])
  @@index([status])
  @@index([category])
  @@index([slug])
  @@map("courses")
}

model CoursePrerequisite {
  courseId             String
  prerequisiteCourseId String

  course             Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse Course @relation("PrerequisiteForCourses", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
  @@map("course_prerequisites")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, orderIndex])
  @@map("course_modules")
}

model Lesson {
  id              String            @id @default(uuid())
  moduleId        String
  title           String
  description     String?
  contentType     LessonContentType @default(VIDEO)
  content         String?
  resourceUrl     String?
  durationMinutes Int?
  orderIndex      Int               @default(0)
  isPreview       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgress  LessonProgress[]
  lessonResources LessonResource[]
  lessonTopics    LessonTopic[]

  @@index([moduleId, orderIndex])
  @@map("lessons")
}

model Enrollment {
  id                 String           @id @default(uuid())
  userId             String
  courseId           String
  status             EnrollmentStatus @default(ENROLLED)
  progressPercentage Float            @default(0)
  enrolledAt         DateTime         @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  lastAccessedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id                 String    @id @default(uuid())
  userId             String
  lessonId           String
  enrollmentId       String
  completed          Boolean   @default(false)
  progressPercentage Float     @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  lastAccessedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

// ==============================================================================
// 7. LEARNING RESOURCES
// ==============================================================================

model Resource {
  id             String         @id @default(uuid())
  uploadedBy     String
  organizationId String
  title          String
  description    String?
  resourceType   ResourceType   @default(DOCUMENT)
  storageKey     String
  url            String?
  fileName       String?
  mimeType       String?
  fileSize       BigInt?
  thumbnailUrl   String?
  status         ResourceStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  uploader        User             @relation("ResourceUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  courseResources CourseResource[]
  lessonResources LessonResource[]
  recommendations Recommendation[]

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([status])
  @@index([resourceType])
  @@map("resources")
}

model CourseResource {
  courseId   String
  resourceId String

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([courseId, resourceId])
  @@index([courseId])
  @@index([resourceId])
  @@map("course_resources")
}

model LessonResource {
  lessonId   String
  resourceId String

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([lessonId, resourceId])
  @@index([lessonId])
  @@index([resourceId])
  @@map("lesson_resources")
}

// ==============================================================================
// 8. ASSESSMENTS & ATTEMPTS
// ==============================================================================

model Assessment {
  id              String           @id @default(uuid())
  courseId        String?
  trainerId       String
  title           String
  description     String?
  subject         String
  assessmentType  AssessmentType   @default(MCQ)
  durationMinutes Int?
  passingScore    Float            @default(60.0)
  startAt         DateTime?
  deadline        DateTime?
  status          AssessmentStatus @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  course    Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  trainer   User                 @relation("TrainerAssessments", fields: [trainerId], references: [id], onDelete: Restrict)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
  feedbacks Feedback[]

  @@index([courseId])
  @@index([trainerId])
  @@index([deadline])
  @@index([status])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String       @id @default(uuid())
  assessmentId String
  questionText String
  questionType QuestionType @default(SINGLE_CHOICE)
  marks        Float        @default(1.0)
  orderIndex   Int          @default(0)
  explanation  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options        QuestionOption[]
  answers        AssessmentAnswer[]
  questionTopics AssessmentQuestionTopic[]

  @@index([assessmentId, orderIndex])
  @@map("assessment_questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AssessmentAnswer[]

  @@index([questionId, orderIndex])
  @@map("question_options")
}

model AssessmentAttempt {
  id               String        @id @default(uuid())
  assessmentId     String
  userId           String
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  score            Float?
  percentage       Float?
  passed           Boolean?
  timeTakenSeconds Int?
  status           AttemptStatus @default(IN_PROGRESS)
  createdAt        DateTime      @default(now())

  assessment        Assessment                   @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           AssessmentAnswer[]
  competencyResults AssessmentCompetencyResult[]

  @@index([userId])
  @@index([assessmentId])
  @@index([status])
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean?
  marksObtained    Float?
  answeredAt       DateTime @default(now())

  attempt        AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId])
  @@map("assessment_answers")
}

// ==============================================================================
// 9. COMPETENCIES, LEVELS & SKILL GAPS
// ==============================================================================

model Competency {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels                      CompetencyLevel[]
  courseCompetencies          CourseCompetency[]
  userCompetencies            UserCompetency[]
  assessmentCompetencyResults AssessmentCompetencyResult[]
  skillGaps                   SkillGap[]
  recommendations             Recommendation[]
  trainerMatches              TrainerMatch[]
  topicCompetencies           LearningTopicCompetency[]

  // AI Skill Gap Analyzer relations
  prerequisites               CompetencyPrerequisite[]     @relation("CompetencyPrerequisites")
  prerequisiteFor             CompetencyPrerequisite[]     @relation("PrerequisiteForCompetencies")
  rootCauseForGaps            SkillGap[]                   @relation("RootCauseCompetency")
  analysisItems               SkillGapAnalysisItem[]

  @@index([category])
  @@index([code])
  @@map("competencies")
}

model CompetencyLevel {
  id           String  @id @default(uuid())
  competencyId String
  level        Int
  name         String
  description  String?

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([competencyId, level])
  @@index([competencyId])
  @@map("competency_levels")
}

model CourseCompetency {
  id           String                 @id @default(uuid())
  courseId     String
  competencyId String
  targetLevel  Int                    @default(1)
  importance   Float                  @default(1.0)
  criticality  RequirementCriticality @default(NORMAL)
  weight       Float                  @default(1.0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt @default(now())

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([courseId, competencyId])
  @@index([courseId])
  @@index([competencyId])
  @@map("course_competencies")
}

model UserCompetency {
  id              String           @id @default(uuid())
  userId          String
  competencyId    String
  currentLevel    Int              @default(0)
  confidenceScore Float?
  competencyScore Float            @default(50.0)
  evidenceCount   Int              @default(0)
  lastAssessedAt  DateTime?
  lastActivityAt  DateTime?
  stability       Float            @default(1.0)
  retention       Float            @default(1.0)
  forgettingRisk  Float            @default(0.0)
  source          CompetencySource @default(PROFILE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([userId, competencyId])
  @@index([userId])
  @@index([competencyId])
  @@map("user_competencies")
}

model AssessmentCompetencyResult {
  id            String   @id @default(uuid())
  attemptId     String
  competencyId  String
  score         Float
  levelAchieved Int
  createdAt     DateTime @default(now())

  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  competency Competency        @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@index([competencyId])
  @@map("assessment_competency_results")
}

model SkillGap {
  id                    String      @id @default(uuid())
  userId                String
  competencyId          String
  courseId              String?
  currentLevel          Int
  requiredLevel         Int
  gapLevel              Int
  gapSeverity           Float?
  priorityScore         Float?
  classification        String?
  gapType               String?
  rootCauseCompetencyId String?
  reasonCodes           String[]    @default([])
  priority              GapPriority @default(MEDIUM)
  status                GapStatus   @default(OPEN)
  calculatedAt          DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency          Competency  @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  course              Course?     @relation("CourseSkillGaps", fields: [courseId], references: [id], onDelete: Cascade)
  rootCauseCompetency Competency? @relation("RootCauseCompetency", fields: [rootCauseCompetencyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([competencyId])
  @@index([courseId])
  @@index([priority])
  @@index([status])
  @@map("skill_gaps")
}

// ==============================================================================
// 10. RECOMMENDATIONS & TRAINER MATCHING
// ==============================================================================

model Recommendation {
  id                 String               @id @default(uuid())
  userId             String
  recommendationType RecommendationType
  courseId           String?
  trainerId          String?
  resourceId         String?
  competencyId       String?
  batchId            String?
  rankPosition       Int?
  algorithmVersion   String               @default("v1.0.0")
  surface            String               @default("HOME")
  candidateSource    String?
  reasonCodes        String[]             @default([])
  featureSnapshot    Json?
  shownAt            DateTime?
  clickedAt          DateTime?
  actedAt            DateTime?
  score              Float?
  reason             String?
  source             RecommendationSource @default(RULE_ENGINE)
  status             RecommendationStatus @default(ACTIVE)
  metadata           Json?
  createdAt          DateTime             @default(now())
  expiresAt          DateTime?

  user           User                    @relation("UserRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  course         Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  trainer        User?                   @relation("TrainerRecommendations", fields: [trainerId], references: [id], onDelete: SetNull)
  resource       Resource?               @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  competency     Competency?             @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  batch          RecommendationBatch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  events         RecommendationEvent[]
  feedbacks      RecommendationFeedback[]

  @@index([userId])
  @@index([recommendationType])
  @@index([status])
  @@index([batchId])
  @@index([createdAt])
  @@map("recommendations")
}

model RecommendationBatch {
  id               String           @id @default(uuid())
  userId           String
  surface          String           @default("HOME")
  context          Json?
  algorithmVersion String           @default("v1.0.0")
  createdAt        DateTime         @default(now())
  expiresAt        DateTime?

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  events          RecommendationEvent[]

  @@index([userId])
  @@index([surface])
  @@index([createdAt])
  @@map("recommendation_batches")
}

model RecommendationEvent {
  id               String                  @id @default(uuid())
  userId           String
  recommendationId String?
  batchId          String?
  eventType        RecommendationEventType
  position         Int?
  surface          String                  @default("HOME")
  courseId         String?
  resourceId       String?
  trainerId        String?
  sessionId        String?
  metadata         Json?
  createdAt        DateTime                @default(now())

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation?       @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  batch          RecommendationBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  course         Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recommendationId])
  @@index([batchId])
  @@index([eventType])
  @@index([courseId])
  @@index([createdAt])
  @@map("recommendation_events")
}

model RecommendationFeedback {
  id               String                     @id @default(uuid())
  userId           String
  recommendationId String
  feedbackType     RecommendationFeedbackType
  reason           String?
  rating           Int?
  createdAt        DateTime                   @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recommendationId])
  @@index([feedbackType])
  @@map("recommendation_feedbacks")
}

model RecommendationAlgorithmConfig {
  id                    String    @id @default(uuid())
  version               String    @unique
  skillWeight           Float     @default(0.25)
  contentWeight         Float     @default(0.15)
  behaviorWeight        Float     @default(0.15)
  collaborativeWeight   Float     @default(0.10)
  qualityWeight         Float     @default(0.10)
  contextWeight         Float     @default(0.08)
  popularityWeight      Float     @default(0.07)
  freshnessWeight       Float     @default(0.05)
  explorationWeight     Float     @default(0.05)
  explorationPercentage Float     @default(0.15)
  diversityLambda       Float     @default(0.70)
  maxSameCategory       Int       @default(3)
  maxSameGroup          Int       @default(2)
  maxSameTrainer        Int       @default(2)
  minimumEvidence       Int       @default(3)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  activatedAt           DateTime  @default(now())
  deactivatedAt         DateTime?

  @@map("recommendation_algorithm_configs")
}

model UserRecommendationProfile {
  id                    String   @id @default(uuid())
