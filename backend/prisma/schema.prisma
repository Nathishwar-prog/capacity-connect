model RevisionSession {
  id               String                @id @default(uuid())
  userId           String
  courseId         String
  availableMinutes Int
  focusGroupId     String?
  sessionType      String                @default("ADAPTIVE_COMPETENCY")
  status           RevisionSessionStatus @default(GENERATED)
  algorithmVersion String                @default("v1.0.0")
  startedAt        DateTime?
  completedAt      DateTime?
