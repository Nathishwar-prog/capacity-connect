model RevisionAlgorithmConfig {
  id                            String    @id @default(uuid())
  version                       String    @unique
  topicWeaknessWeight           Float     @default(0.35)
  topicForgettingWeight         Float     @default(0.18)
  topicImportanceWeight         Float     @default(0.12)
  topicDependencyWeight         Float     @default(0.12)
  topicErrorWeight              Float     @default(0.10)
  topicUncertaintyWeight        Float     @default(0.08)
  topicRecencyWeight            Float     @default(0.05)
  groupWeaknessWeight           Float     @default(0.40)
  groupForgettingWeight         Float     @default(0.20)
  groupImportanceWeight         Float     @default(0.15)
  groupDependencyWeight         Float     @default(0.15)
  groupUncertaintyWeight        Float     @default(0.10)
  cooldownHours                 Int       @default(24)
  masteryThreshold              Float     @default(85.0)
  diagnosticConfidenceThreshold Float     @default(0.40)
  maxTopicsPerSession           Int       @default(6)
  maxGroupConcentration         Float     @default(0.80)
  primaryGroupAllocation        Float     @default(0.70)
  prerequisiteAllocation        Float     @default(0.20)
  retentionAllocation           Float     @default(0.10)
  isActive                      Boolean   @default(true)
  createdAt                     DateTime  @default(now())
  activatedAt                   DateTime  @default(now())
