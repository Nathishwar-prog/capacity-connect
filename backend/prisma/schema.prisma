  @@index([userId])
  @@index([topicId])
  @@index([userId, priorityScore])
  @@index([topicId, priorityScore])
  @@index([nextReviewAt])
  @@map("user_topic_competencies")
}

model UserGroupCompetency {
  id                    String    @id @default(uuid())
  userId                String
  groupId               String
  groupCompetency       Float     @default(50.0)
  groupConfidence       Float     @default(0.1)
  groupWeakness         Float     @default(50.0)
  groupForgettingRisk   Float     @default(0.0)
  groupImportance       Float     @default(1.0)
  groupDependencyImpact Float     @default(0.0)
