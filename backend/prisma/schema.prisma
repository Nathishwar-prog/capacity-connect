model RevisionSessionItem {
  id                    String          @id @default(uuid())
  sessionId             String
  topicId               String
  sequenceNumber        Int
  priorityScore         Float
  groupPriorityScore    Float
  weaknessScore         Float
  forgettingRiskScore   Float
  importanceScore       Float
  dependencyImpactScore Float
  errorSeverityScore    Float
  uncertaintyScore      Float
  recencyScore          Float
  reason                Json
  reasonCodes           String[]
  revisionMode          RevisionMode
  allocatedMinutes      Int
  status                String          @default("PENDING")
  preCompetency         Float?
  postCompetency        Float?
  educationalContent    Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  session RevisionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic   LearningTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  outcome RevisionOutcome?

  @@index([sessionId, sequenceNumber])
  @@index([topicId])
  @@map("revision_session_items")
}

model RevisionOutcome {
  id                 String   @id @default(uuid())
  sessionId          String
  sessionItemId      String   @unique
  userId             String
  topicId            String
  preScore           Float
  postScore          Float
  questionsPresented Int      @default(0)
  questionsAnswered  Int      @default(0)
  correctAnswers     Int      @default(0)
  timeSpentSeconds   Int      @default(0)
  retrievalScore     Float?
  completed          Boolean  @default(true)
  createdAt          DateTime @default(now())

  session     RevisionSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionItem RevisionSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       LearningTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([topicId])
  @@map("revision_outcomes")
}

// ==============================================================================
// 13. AI SKILL GAP ANALYZER
// ==============================================================================

model CompetencyPrerequisite {
  id                       String   @id @default(uuid())
  prerequisiteCompetencyId String
  dependentCompetencyId    String
  edgeWeight               Float    @default(1.0)
  dependencyType           String   @default("DIRECT")
  createdAt                DateTime @default(now())

  prerequisiteCompetency Competency @relation("PrerequisiteForCompetencies", fields: [prerequisiteCompetencyId], references: [id], onDelete: Cascade)
  dependentCompetency    Competency @relation("CompetencyPrerequisites", fields: [dependentCompetencyId], references: [id], onDelete: Cascade)

  @@unique([prerequisiteCompetencyId, dependentCompetencyId])
  @@index([prerequisiteCompetencyId])
  @@index([dependentCompetencyId])
  @@map("competency_prerequisites")
}

model SkillGapAlgorithmConfig {
  id                     String    @id @default(uuid())
  version                String    @unique
  severityWeight         Float     @default(0.35)
  importanceWeight       Float     @default(0.20)
  dependencyWeight       Float     @default(0.15)
  uncertaintyWeight      Float     @default(0.10)
  forgettingWeight       Float     @default(0.10)
  errorSeverityWeight    Float     @default(0.10)
  coreMultiplier         Float     @default(1.25)
  importantMultiplier    Float     @default(1.10)
  normalMultiplier       Float     @default(1.00)
  optionalMultiplier     Float     @default(0.80)
  readinessThresholdFull Float     @default(80.0)
  readinessThresholdCond Float     @default(60.0)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  activatedAt            DateTime  @default(now())
  deactivatedAt          DateTime?

  @@map("skill_gap_algorithm_configs")
}

model SkillGapAnalysis {
  id                String   @id @default(uuid())
  userId            String
  courseId          String?
  algorithmVersion  String   @default("v1.0.0")
  readinessScore    Float
  coreReadiness     Float
  criticalReadiness Float
  readinessStatus   String   // NOT_READY, CONDITIONAL, GENERALLY_READY, FULLY_READY
  summary           Json?
  aiGuidance        Json?
  createdAt         DateTime @default(now())

  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  SkillGapAnalysisItem[]

  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
  @@map("skill_gap_analyses")
}

model SkillGapAnalysisItem {
  id                    String                 @id @default(uuid())
  analysisId            String
  competencyId          String
  currentLevel          Int
  requiredLevel         Int
  gapLevel              Int
  gapSeverity           Float
  priorityScore         Float
  classification        String                 // MISSING, WEAK, AT_RISK, UNCERTAIN, MEETS_REQUIREMENT, EXCEEDS_REQUIREMENT
  gapType               String                 // NO_GAP, LOW, MEDIUM, HIGH, CRITICAL
  trend                 String                 @default("NEW") // IMPROVING, STABLE, WORSENING, NEW, RESOLVED
  criticality           RequirementCriticality @default(NORMAL)
  rootCauseCompetencyId String?
  contributingPrereqs   String[]               @default([])
  reasonCodes           String[]               @default([])
  details               Json?
  createdAt             DateTime               @default(now())

  analysis   SkillGapAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  competency Competency       @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@index([analysisId])
  @@index([competencyId])
  @@map("skill_gap_analysis_items")
}

