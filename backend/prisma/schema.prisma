model CourseRecommendationProfile {
  id               String   @id @default(uuid())
  courseId         String   @unique
  skillCoverage    Json?
  topicCoverage    Json?
  qualityScore     Float    @default(75.0)
  completionRate   Float    @default(0.0)
  averageRating    Float    @default(4.5)
