  @@index([userId])
  @@index([groupId])
  @@index([userId, groupPriority])
  @@map("user_group_competencies")
}

model UserTopicError {
  id                String    @id @default(uuid())
  userId            String
  topicId           String
  errorType         String
  errorCode         String?
  description       String?
  errorCount        Int       @default(1)
  severity          Float     @default(20.0)
  firstDetectedAt   DateTime  @default(now())
  lastDetectedAt    DateTime  @default(now())
  resolvedAt        DateTime?
  exampleQuestionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

