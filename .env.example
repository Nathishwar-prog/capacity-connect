# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Capacity Connect)
# ==============================================================================
# Copy this file to '.env' and fill in the values before starting development.

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- DATABASE CONFIGURATION (PostgreSQL / Neon) ---
# Connection pooling URL (used by application runtime)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/capacity_connect?sslmode=require"

# Direct database connection URL (used by Prisma migrations with Neon)
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/capacity_connect?sslmode=require"

# --- SECURITY & AUTHENTICATION ---
# Generate secure keys using: openssl rand -base64 32
JWT_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"

# Expiration formats compatible with 'jsonwebtoken' library (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cookie settings
COOKIE_SECURE=false # Set to true in production
COOKIE_SAME_SITE="lax" # Options: lax, strict, none

# --- LOGGING ---
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL="info"

# --- EMAIL CONFIGURATION (Nodemailer) ---
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="noreply@capacityconnect.io"

# --- REDIS CONFIGURATION (Cache & BullMQ) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
